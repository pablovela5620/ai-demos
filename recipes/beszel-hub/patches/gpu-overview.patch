diff --git a/internal/hub/systems/gpu_overview_test.go b/internal/hub/systems/gpu_overview_test.go
new file mode 100644
index 0000000..ababbb7
--- /dev/null
+++ b/internal/hub/systems/gpu_overview_test.go
@@ -0,0 +1,64 @@
+//go:build testing
+
+package systems_test
+
+import (
+	"fmt"
+	"net/http"
+	"testing"
+
+	"github.com/henrygd/beszel/internal/entities/system"
+	"github.com/henrygd/beszel/internal/tests"
+	pbtests "github.com/pocketbase/pocketbase/tests"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOverviewReportsCurrentGPUCount(t *testing.T) {
+	// Successive reports from the same agent must replace presence, not retain
+	// the last detected device after collection becomes unavailable.
+	for _, tc := range []struct {
+		name  string
+		gpus  map[string]system.GPUData
+		usage float64
+		count int
+	}{
+		{"idle device", map[string]system.GPUData{"device-a": {Name: "GPU", Usage: 0}}, 0, 1},
+		{"two idle devices", map[string]system.GPUData{"device-a": {}, "device-b": {}}, 0, 2},
+		{"two busy devices keep aggregate", map[string]system.GPUData{"device-a": {Usage: 11}, "device-b": {Usage: 73.5}}, 73.5, 2},
+		{"empty collection", map[string]system.GPUData{}, 0, 0},
+		{"no GPU collection", nil, 0, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			hub, user := tests.GetHubWithUser(t)
+			defer hub.Cleanup()
+			token, err := user.NewAuthToken()
+			require.NoError(t, err)
+			records, err := tests.CreateSystems(hub, 1, user.Id, "paused")
+			require.NoError(t, err)
+			monitored, err := hub.GetSystemManager().GetSystem(records[0].Id)
+			require.NoError(t, err)
+			_, err = monitored.CreateRecords(&system.CombinedData{
+				Stats: system.Stats{GPUData: map[string]system.GPUData{"previous": {}}},
+			})
+			require.NoError(t, err)
+			_, err = monitored.CreateRecords(&system.CombinedData{
+				Info:  system.Info{GpuPct: tc.usage},
+				Stats: system.Stats{GPUData: tc.gpus},
+			})
+			require.NoError(t, err)
+			expected := []string{fmt.Sprintf(`"gc":%d`, tc.count), `"status":"up"`}
+			if tc.usage > 0 {
+				expected = append(expected, `"g":73.5`)
+			}
+			scenario := tests.ApiScenario{
+				Method:          http.MethodGet,
+				URL:             "/api/collections/systems/records/" + records[0].Id,
+				Headers:         map[string]string{"Authorization": token},
+				ExpectedStatus:  http.StatusOK,
+				ExpectedContent: expected,
+				TestAppFactory:  func(testing.TB) *pbtests.TestApp { return hub.TestApp },
+			}
+			scenario.Test(t)
+		})
+	}
+}
diff --git a/internal/site/src/components/systems-table/gpu-usage.ts b/internal/site/src/components/systems-table/gpu-usage.ts
new file mode 100644
index 0000000..ee04443
--- /dev/null
+++ b/internal/site/src/components/systems-table/gpu-usage.ts
@@ -0,0 +1,6 @@
+import type { SystemRecord } from "@/types"
+
+/** GPU utilization for the overview, or undefined when no reading is available. */
+export function overviewGpuUsage({ info, status }: Pick<SystemRecord, "info" | "status">): number | undefined {
+	return status === "up" && (info.gc ?? 0) > 0 ? (info.g ?? 0) : undefined
+}
diff --git a/internal/site/src/components/systems-table/gpu-usage.test.ts b/internal/site/src/components/systems-table/gpu-usage.test.ts
new file mode 100644
index 0000000..d659a43
--- /dev/null
+++ b/internal/site/src/components/systems-table/gpu-usage.test.ts
@@ -0,0 +1,17 @@
+import { expect, test } from "bun:test"
+import type { SystemRecord } from "@/types"
+import { overviewGpuUsage } from "./gpu-usage"
+
+test.each([
+	["one idle GPU", "up", { gc: 1, g: 0 }, 0],
+	["idle GPU with zero omitted from JSON", "up", { gc: 1 }, 0],
+	["two idle GPUs", "up", { gc: 2, g: 0 }, 0],
+	["existing aggregate of two busy GPUs", "up", { gc: 2, g: 73.5 }, 73.5],
+	["no detected GPU", "up", { gc: 0, g: 0 }, undefined],
+	["no agent report", "pending", {}, undefined],
+	["offline GPU with stale utilization", "down", { gc: 1, g: 83 }, undefined],
+	["paused GPU", "paused", { gc: 1, g: 12 }, undefined],
+	["missing collection with stale aggregate", "up", { gc: 0, g: 25 }, undefined],
+] as const)("%s", (_, status, info, expected) => {
+	expect(overviewGpuUsage({ status, info } as Pick<SystemRecord, "info" | "status">)).toBe(expected)
+})
