diff --git a/crates/top/re_viewer/build.rs b/crates/top/re_viewer/build.rs
index ceaf9af..accdaf4 100644
--- a/crates/top/re_viewer/build.rs
+++ b/crates/top/re_viewer/build.rs
@@ -17,6 +17,49 @@ fn main() {
 
     re_build_tools::export_build_info_vars_for_crate("re_viewer");
 
+    let target_os = re_build_tools::get_and_track_env_var("CARGO_CFG_TARGET_OS");
+    let target_arch = re_build_tools::get_and_track_env_var("CARGO_CFG_TARGET_ARCH");
+    if target_os.as_deref() == Ok("linux") && target_arch.as_deref() == Ok("aarch64") {
+        // `re_rav1d` contains hand-written AArch64 assembly that refers to globals such as
+        // `dav1d_mc_warp_filter` using instructions that encode an address relative to the current
+        // instruction. These instructions can only reach addresses within roughly 4 GiB. When
+        // producing a shared object, a symbol may instead be replaced by a definition from another
+        // shared object at runtime. That definition could be anywhere in memory, so this kind of
+        // address cannot be resolved safely and the linker reports a "recompile with -fPIC" error.
+        //
+        // `-Wl,` tells the compiler's linker driver to pass the remaining comma-separated options to the ELF linker.
+        // `--exclude-libs,ALL` marks symbols originating in static archives as hidden for
+        // the purpose of the static link itself. This guarantees that the rav1d globals bind to
+        // their definitions in this shared object, allowing the linker to resolve the direct
+        // relocations.
+        //
+        // `ALL` applies to every static archive in this link because Cargo gives rlibs hashed file
+        // names, such as `libre_rav1d-<hash>.rlib`; GNU ld requires exact archive names and cannot
+        // select that archive with a crate-name wildcard. This does not hide symbols defined by
+        // the cdylib itself. Rust cdylibs also generally should not re-export implementation
+        // details pulled in from their statically linked dependencies.
+        //
+        // The Cargo directive applies only when this package is linked as a
+        // `cdylib` (that's the `rustc-link-arg-cdylib` bit!) it is not embedded in the `re_viewer`
+        // rlib and does not propagate to downstream shared libraries.
+        //
+        // # Could we use a linker version script to hide the symbols instead?
+        //
+        // Hiding matching names with a linker version script does not work out here:
+        // ld validates these relocations while it is still processing the input archive, before the
+        // output's dynamic symbol visibility from a version script can make the references safe.
+        //
+        // # How should this be fixed upstream?
+        //
+        // `re_rav1d` should mark internal globals used by its assembly as hidden, e.g.
+        // `.hidden dav1d_mc_warp_filter`. This tells the linker that direct references resolve
+        // inside the same shared library. Symbols that must remain replaceable by another shared
+        // library should instead be accessed through the Global Offset Table (GOT), which the
+        // runtime linker fills with the symbol's final address. The fix should be tested by linking
+        // an AArch64 Linux `cdylib` with GNU ld.bfd; once released, this workaround can be removed.
+        println!("cargo::rustc-link-arg-cdylib=-Wl,--exclude-libs,ALL");
+    }
+
     // The context is a couple of megabytes of documentation, and the web viewer has no
     // agent panel to hand it to.
     let embed = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default() != "wasm32"
