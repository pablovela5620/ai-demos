+    async fn test_stalled_receiver_does_not_block_sender() {
+        // One receiver never reads, like a web viewer in a backgrounded tab.
+        let (tx, mut stalled_rx) = channel::<u32>("test", 4, u64::MAX);
+        let mut live_rx = tx.subscribe();
+        let num_messages = 64;
+
+        let reader = tokio::spawn(async move {
+            let mut received = Vec::new();
+            for _ in 0..num_messages {
+                received.push(live_rx.recv().await.unwrap());
+            }
+            received
+        });
+
+        // The sender waits once for the stalled receiver, then overflows.
+        // Yielding lets the live receiver keep up, as a real viewer does.
+        tokio::time::timeout(SLOW_RECEIVER_TIMEOUT * 3, async {
+            for i in 0..num_messages {
+                tx.send_async(i).await.unwrap();
+                tokio::task::yield_now().await;
+            }
+        })
+        .await
+        .expect("a stalled receiver must not block the sender");
+
+        // The live receiver got everything, in order:
+        let received = tokio::time::timeout(SLOW_RECEIVER_TIMEOUT, reader)
+            .await
+            .expect("the live receiver must not fall behind")
+            .unwrap();
+        assert_eq!(received, (0..num_messages).collect::<Vec<_>>());
+
+        // The stalled receiver skips ahead to the oldest message still in the channel:
+        assert!(0 < stalled_rx.recv().await.unwrap());
+    }
